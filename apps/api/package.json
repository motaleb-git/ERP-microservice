{
  "name": "@erp/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && nest build",
    "dev": "nest start --watch",
    "worker:dev": "nest start --watch --entryFile worker",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint src --no-error-on-unmatched-pattern",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "prisma:generate": "prisma generate",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@erp/config": "workspace:*",
    "@erp/shared": "workspace:*",
    "@erp/types": "workspace:*",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/schedule": "^6.0.1",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/client": "^6.15.0",
    "amqplib": "^0.10.8",
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "bullmq": "^5.58.0",
    "dotenv": "^17.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "jsonwebtoken": "^9.0.2",
    "nestjs-cls": "^5.4.3",
    "nestjs-pino": "^4.4.0",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "pino-pretty": "^13.1.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@erp/tsconfig": "workspace:*",
    "@eslint/js": "^9.33.0",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "^11.1.6",
    "@types/amqplib": "^0.10.7",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.17.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.33.0",
    "jest": "^29.7.0",
    "prisma": "^6.15.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
